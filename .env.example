# Application Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="MONITRIACH CORE"
VERSION=1.0.0

# Security & JWT
SECRET_KEY=change-this-ultra-secret-jwt-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=monitriach
POSTGRES_PASSWORD=monitriach_secret
POSTGRES_DB=monitriach_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://monitriach:monitriach_secret@localhost:5432/monitriach_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS & Frontend URL
CORS_ORIGINS=["http://localhost:3000","http://localhost","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
